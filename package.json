{
  "name": "vscode-github-markdown-preview",
  "displayName": "Ascreit Mermaid Markdown Preview",
  "description": "Render Mermaid diagrams in VS Code's built-in Markdown preview with GitHub-like styling.",
  "version": "0.0.1",
  "publisher": "ascreit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ascreit/vscode-github-markdown-preview.git"
  },
  "bugs": {
    "url": "https://github.com/ascreit/vscode-github-markdown-preview/issues"
  },
  "homepage": "https://github.com/ascreit/vscode-github-markdown-preview#readme",
  "keywords": [
    "markdown",
    "preview",
    "mermaid",
    "github",
    "diagram"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.92.0"
  },
  "activationEvents": [
    "onCommand:githubMarkdownPreview.showPreview",
    "onCommand:githubMarkdownPreview.showMarkdown"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "contributes": {
    "commands": [
      {
        "command": "githubMarkdownPreview.showPreview",
        "title": "Preview",
        "category": "GitHub Markdown Preview"
      },
      {
        "command": "githubMarkdownPreview.showMarkdown",
        "title": "Markdown",
        "category": "GitHub Markdown Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "githubMarkdownPreview.showPreview",
          "when": "resourceLangId == markdown && activeWebviewPanelId != 'markdown.preview' && activeCustomEditorId != 'vscode.markdown.preview.editor'",
          "group": "navigation@1"
        },
        {
          "command": "githubMarkdownPreview.showMarkdown",
          "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@1"
        }
      ]
    },
    "markdown.previewScripts": [
      "./media/mermaid.min.js",
      "./media/preview.js"
    ],
    "markdown.previewStyles": [
      "./media/preview.css"
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.extension.json && tsc -p tsconfig.preview.json",
    "check": "tsc -p . && npm run compile && node --check extension.js && node --check media/preview.js",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run compile",
    "install:local": "code --install-extension vscode-github-markdown-preview-0.0.1.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "1.92.0",
    "@vscode/vsce": "^3.9.1",
    "mermaid": "^11.12.0",
    "typescript": "^5.9.3"
  }
}
